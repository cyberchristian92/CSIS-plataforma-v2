# Copie este arquivo para ".env" e ajuste se precisar. Os valores abaixo já
# batem com o docker-compose.yml da raiz do repositório — não precisam mudar
# pra rodar localmente.

# --- Banco de dados --------------------------------------------------------
# Se você está rodando o backend FORA do Docker (via `npm run start:dev`),
# use "localhost:5433" (porta exposta pelo docker-compose.yml).
# Se o backend também estiver rodando DENTRO do Docker Compose, use "db:5432"
# (nome do serviço na rede interna do Compose) — o docker-compose.yml já
# injeta essa versão automaticamente, não precisa editar isso à mão.
DATABASE_URL="postgresql://csis_user:csis_password@localhost:5433/csis_db?schema=public"

# --- Autenticação ------------------------------------------------------------
# Segredo usado para assinar os JWTs. Gere o seu com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# NUNCA reaproveite o valor de exemplo abaixo em produção.
JWT_SECRET="42a6c312b8ba18a0a8d0f2907f09b6776d922059b1dfd1d5535d7b2a1f927d105dadc9ed1abbd975571d44e84575d502"
JWT_EXPIRES_IN="1d"

# --- Servidor ----------------------------------------------------------------
PORT=3000

# Origem(ns) do frontend permitida(s) para CORS (separar por vírgula se
# precisar liberar mais de uma, ex: acesso pelo navegador do celular na
# mesma rede local).
FRONTEND_ORIGIN="http://localhost:5000"

# --- Seed (usuário administrador criado automaticamente no primeiro boot) --
# Usados por `prisma/seed.ts` — só valem na primeira vez (banco vazio).
SEED_ADMIN_NOME="Administrador"
SEED_ADMIN_EMAIL="admin@csis.local"
SEED_ADMIN_SENHA="TrocarSenha123"
