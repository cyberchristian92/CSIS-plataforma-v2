# Copie este arquivo para ".env" e ajuste se precisar. Os valores abaixo já
# batem com o docker-compose.yml da raiz do repositório — não precisam mudar
# pra rodar localmente.

# --- Banco de dados --------------------------------------------------------
# Se você está rodando o backend FORA do Docker (via `npm run start:dev`),
# use "localhost:5433" (porta exposta pelo docker-compose.yml).
# Se o backend também estiver rodando DENTRO do Docker Compose, use "db:5432"
# (nome do serviço na rede interna do Compose) — o docker-compose.yml já
# injeta essa versão automaticamente, não precisa editar isso à mão.
DATABASE_URL="postgresql://csis_user:csis_password@localhost:5433/csis_db?schema=public"

# --- Autenticação ------------------------------------------------------------
# Segredo usado para assinar os JWTs. Gere o seu com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# NUNCA reaproveite o valor de exemplo abaixo em produção.
JWT_SECRET="42a6c312b8ba18a0a8d0f2907f09b6776d922059b1dfd1d5535d7b2a1f927d105dadc9ed1abbd975571d44e84575d502"
JWT_EXPIRES_IN="1d"

# --- Servidor ----------------------------------------------------------------
PORT=3000

# Origem(ns) do frontend permitida(s) para CORS (separar por vírgula se
# precisar liberar mais de uma, ex: acesso pelo navegador do celular na
# mesma rede local).
FRONTEND_ORIGIN="http://localhost:5174"
# A PRIMEIRA origem da lista também é a base dos links enviados por e-mail
# (convite, confirmação de cadastro, redefinição de senha) — em produção,
# coloque o endereço público primeiro, ex.: "https://csis.suaempresa.com.br".

# Atrás de proxy reverso / Cloudflare Tunnel: quantos saltos de proxy
# confiar para descobrir o IP real do cliente (usado no limite de
# tentativas de login). Deixe vazio rodando sem proxy.
# TRUST_PROXY=1

# --- E-mail (SMTP) -------------------------------------------------------------
# Sem SMTP_HOST, nenhum e-mail sai: a tela de convite mostra o link para o
# Admin copiar e mandar por outro canal. Funciona com qualquer provedor
# (Brevo: smtp-relay.brevo.com:587; Gmail: smtp.gmail.com:587 com senha de app).
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="CSIS <nao-responda@suaempresa.com.br>"

# --- Cadastro público ------------------------------------------------------------
# "false" fecha o cadastro pela tela de login (só entra quem for convidado).
CADASTRO_ABERTO=true
# Cadastros aceitos por hora vindos do mesmo IP (anti-spam).
CADASTRO_LIMITE_POR_HORA=10
# Tamanho máximo de cada anexo do formulário de inscrição, em MB.
MAX_ANEXO_INSCRICAO_MB=10

# --- Uploads ------------------------------------------------------------------------
# Tamanho máximo de cada arquivo enviado a um projeto, em MB (imagens
# forenses costumam passar de 1 GB).
MAX_UPLOAD_MB=4096
# UPLOADS_DIR=/caminho/para/uploads

# --- Laudo (geração de PDF) --------------------------------------------------------
# Pasta compartilhada com o motor de compilação (serviço "pandoc" do
# docker-compose). Padrão: ./laudo-workdir, que é a pasta que o compose monta.
# LAUDO_WORKDIR=/caminho/para/laudo-workdir
# Tempo máximo de uma compilação, em segundos (o mesmo valor vale no worker).
# LAUDO_TIMEOUT_S=120

# --- Seed (usuário administrador criado automaticamente no primeiro boot) --
# Usados por `prisma/seed.ts` — só valem na primeira vez (banco vazio).
SEED_ADMIN_NOME="Administrador"
SEED_ADMIN_EMAIL="admin@csis.local"
SEED_ADMIN_SENHA="TrocarSenha123"

# "Entrar com Google" (opcional). Sem estas duas, o botão não aparece.
# Google Cloud Console → APIs e serviços → Credenciais → ID do cliente OAuth
# (Aplicativo da Web). Em "URIs de redirecionamento autorizados", cadastre
# <endereço do frontend>/api/auth/google/callback — ex.:
#   https://csis.suaempresa.com.br/api/auth/google/callback
#   http://localhost:5174/api/auth/google/callback   (desenvolvimento)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
