# Configuração da instância de produção (docker-compose.prod.yml).
# O deploy/instalar.sh gera este arquivo sozinho, com senhas aleatórias —
# só edite à mão se quiser mudar algo depois. NUNCA commite o .env.prod.

# Endereço público, sem https:// (ex.: csis-suaempresa.duckdns.org).
DOMINIO=

# Senhas geradas aleatoriamente (use só letras e números na DB_SENHA).
DB_SENHA=
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Primeiro administrador — criado só no primeiro boot, com o banco vazio.
SEED_ADMIN_NOME=Administrador
SEED_ADMIN_EMAIL=
SEED_ADMIN_SENHA=

# E-mail (convites, confirmação de cadastro, senha esquecida). Sem SMTP, os
# links aparecem na tela para o Admin copiar e enviar por outro canal.
# Brevo grátis: 300 e-mails/dia — https://www.brevo.com (SMTP & API).
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="CSIS <seu-email-verificado@exemplo.com>"

# Cadastro público com aprovação ("false" = só por convite).
CADASTRO_ABERTO=true
CADASTRO_LIMITE_POR_HORA=10
MAX_ANEXO_INSCRICAO_MB=10
MAX_UPLOAD_MB=4096

# "Entrar com Google" (opcional). Sem estas duas, o botão não aparece.
# Google Cloud Console → APIs e serviços → Credenciais → ID do cliente OAuth
# (Aplicativo da Web). Em "URIs de redirecionamento autorizados", cadastre
# <endereço do frontend>/api/auth/google/callback — ex.:
#   https://csis.suaempresa.com.br/api/auth/google/callback
#   http://localhost:5174/api/auth/google/callback   (desenvolvimento)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# "Entrar com Google" (opcional; sem as duas, o botão não aparece).
# Google Cloud Console → APIs e serviços → Credenciais → ID do cliente OAuth
# (Aplicativo da Web). URI de redirecionamento autorizado:
#   https://<DOMINIO>/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
