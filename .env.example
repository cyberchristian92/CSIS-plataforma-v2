# Copie este arquivo para ".env" (mesma pasta deste arquivo, raiz do repo) —
# o `docker compose up` lê essas variáveis automaticamente. Os valores padrão
# já funcionam para rodar localmente; só precisa editar algo se for expor a
# instância além do seu próprio computador.

# Portas expostas na sua máquina (o que roda dentro do Docker não muda).
DB_PORT=5433
BACKEND_PORT=3000

# Segredo usado para assinar os JWTs de sessão. Gere o seu com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# NUNCA reaproveite o valor de exemplo em produção ou numa instância exposta.
JWT_SECRET=troque-este-segredo-antes-de-usar-em-producao

# Origem do frontend liberada no CORS do backend.
FRONTEND_ORIGIN=http://localhost:5174

# Usuário ADMIN criado automaticamente no primeiro boot (banco vazio).
# Troque a senha pela interface assim que logar pela primeira vez.
SEED_ADMIN_NOME=Administrador
SEED_ADMIN_EMAIL=admin@csis.local
SEED_ADMIN_SENHA=TrocarSenha123
